{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/api-server run build && BASE_PATH=/ PORT=5173 pnpm --filter @workspace/store run build",
  "outputDirectory": "artifacts/store/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/internal/expire-unpaid-orders",
      "schedule": "0 3 * * *"
    }
  ]
}
