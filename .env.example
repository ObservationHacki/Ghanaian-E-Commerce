# Copy to .env for local development. On Replit these are provided as Secrets,
# and real environment variables always take precedence over this file.

# --- Required ---------------------------------------------------------------

# Postgres connection string used by the API server, drizzle-kit and the
# catalog importer. Neon connection strings need the ?sslmode=require suffix.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kumasi

# --- Local ports ------------------------------------------------------------

# Port for the API server.
PORT=5000

# Port for the storefront dev server. Takes precedence over PORT so the two
# processes can share this file.
STORE_PORT=5173

# Where the storefront proxies /api requests during development.
API_PROXY_TARGET=http://localhost:5000

# Public base path the storefront is served under. Required for `vite build`.
BASE_PATH=/

# --- Storefront -------------------------------------------------------------

# Injected into the browser bundle at build time by vite.config.ts.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google sign-in uses Supabase Auth (no client secrets in this repo).
# In the Supabase dashboard: Authentication → Providers → Google → enable,
# then add these Redirect URLs under Authentication → URL Configuration:
#   http://localhost:5173/auth/callback
#   https://YOUR-PRODUCTION-HOST/auth/callback

# Merchant MoMo number shown at checkout (manual verification flow).
# Also readable by the API as MOMO_MERCHANT_NUMBER.
VITE_MOMO_MERCHANT_NUMBER=
# MOMO_MERCHANT_NUMBER=

# Optional public contact details (replace placeholders before launch).
# VITE_CONTACT_PHONE=+233XXXXXXXXX
# VITE_CONTACT_EMAIL=hello@yourdomain.com
# VITE_CONTACT_WHATSAPP=233XXXXXXXXX

# Cloudflare Turnstile (public site key — injected into the storefront bundle).
VITE_TURNSTILE_SITE_KEY=

# --- API server -------------------------------------------------------------

# Supabase project URL (same as storefront). Required for JWT verification.
SUPABASE_URL=

# JWT secret from Supabase → Project Settings → API → JWT Secret.
# Preferred for HS256 tokens; JWKS at /auth/v1/.well-known/jwks.json is the fallback.
SUPABASE_JWT_SECRET=

# Comma-separated emails granted super_admin on API boot (linked on first login).
ADMIN_EMAILS=

# Comma-separated browser origins allowed to call the API (required in production).
# Example: https://yourdomain.com,https://www.yourdomain.com
# Leave unset locally to allow any origin. Never use * in production.
CORS_ORIGINS=http://localhost:5173

# Cloudflare Turnstile secret (API only — never expose to the browser).
# If unset, verification is skipped with a startup warning (local dev).
TURNSTILE_SECRET_KEY=

# Shared secret for scheduled jobs (expire unpaid MoMo orders).
# Call: POST /api/internal/expire-unpaid-orders with header X-Cron-Secret: <value>
CRON_SECRET=

# Hours before unpaid MoMo orders (no reference submitted) are auto-cancelled.
UNPAID_ORDER_EXPIRY_HOURS=24

# Flat delivery fees in GHS (required for checkout — no silent defaults).
# Example: GHS_ACCRA_DELIVERY_FEE=50
# Example: GHS_OUTSIDE_ACCRA_DELIVERY_FEE=100
GHS_ACCRA_DELIVERY_FEE=
GHS_OUTSIDE_ACCRA_DELIVERY_FEE=

# trace | debug | info | warn | error
LOG_LEVEL=info

# Stock is reserved on order create and released on unpaid cancel/expiry.
# Schedule: POST /api/internal/expire-unpaid-orders every 15–60 minutes with X-Cron-Secret.

# --- Catalog image pipeline (scripts) ---------------------------------------

# Optional AI vision verification for product photos (confidence ≥ 0.90).
# Prefer OpenAI; Gemini is used when OpenAI is unset.
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.0-flash
