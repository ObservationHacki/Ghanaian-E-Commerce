{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node ./scripts/preinstall.mjs",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:store": "pnpm --filter @workspace/store run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "catalog:template": "pnpm --filter @workspace/scripts run catalog:template",
    "catalog:from-pricelist": "pnpm --filter @workspace/scripts run catalog:from-pricelist",
    "catalog:import": "pnpm --filter @workspace/scripts run catalog:import",
    "catalog:rescrape-images": "pnpm --filter @workspace/scripts run catalog:rescrape-images",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
